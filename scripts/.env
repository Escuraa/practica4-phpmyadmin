# ==========================================================
#  Variables de configuración - UD02 Práctica 04
#  Sustituir los valores CAMBIA_ESTO antes de ejecutar.
#  No subir a GitHub con contraseñas reales.
# ==========================================================

# MySQL - usuario root
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO

# MySQL - usuario dedicado para phpMyAdmin
DB_USER=pma_admin
DB_PASSWORD=CAMBIA_ESTO

# phpMyAdmin - contraseña del usuario interno 'phpmyadmin'
PMA_APP_PASSWORD=CAMBIA_ESTO

# Nginx - autenticación HTTP básica
HTTP_AUTH_USER=david
HTTP_AUTH_PASSWORD=CAMBIA_ESTO
HTPASSWD_FILE=/etc/nginx/.htpasswd

# Nginx - puerto del sitio de phpMyAdmin
PMA_PORT=8080
